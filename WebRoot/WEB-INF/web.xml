<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <!-- GoodsServlet：处理物资列表、入库出库等逻辑 -->
    <servlet>
        <servlet-name>GoodsServlet</servlet-name>
        <servlet-class>com.warehouse.servlet.GoodsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoodsServlet</servlet-name>
        <!-- 增加/goodsList映射，让访问/goodsList时由GoodsServlet处理 -->
        <url-pattern>/goods</url-pattern>
        <url-pattern>/goodsList</url-pattern>
    </servlet-mapping>

    <!-- 登录Servlet配置 -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.warehouse.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    
    <!-- 退出Servlet配置 -->
    <servlet>
    	<servlet-name>LogoutServlet</servlet-name>
    	<servlet-class>com.warehouse.servlet.LogoutServlet</servlet-class>
	</servlet>
	<servlet-mapping>
    	<servlet-name>LogoutServlet</servlet-name>
    	<url-pattern>/logout</url-pattern>
	</servlet-mapping>
	
	<!-- 操作记录Servlet配置 -->
	<servlet>
    	<servlet-name>RecordServlet</servlet-name>
   		<servlet-class>com.warehouse.servlet.RecordServlet</servlet-class>
	</servlet>
	<servlet-mapping>
    	<servlet-name>RecordServlet</servlet-name>
		<url-pattern>/record</url-pattern>
	</servlet-mapping>

</web-app>